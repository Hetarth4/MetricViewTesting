guid: 77d28545-f5ff-54b5-80fa-559ce6a00705
model:
  name: customer_lifetime_value_metrics
  model_tables:
  - name: fact_order_detail
    fqn: d19573df-e106-4b11-904a-fe0078da9c01
    joins:
    - with: fact_order_header
      'on': '[fact_order_detail::POS_Transaction_Number] = [fact_order_header::POS_Transaction_Number]'
      type: LEFT_OUTER
      cardinality: MANY_TO_ONE
    - with: dim_product
      'on': '[fact_order_detail::Product_Key] = [dim_product::Product_Key]'
      type: LEFT_OUTER
      cardinality: MANY_TO_ONE
  - name: fact_order_header
    fqn: a3d34975-6a7e-4168-ac9a-8099d757e0b2
    joins:
    - with: dim_customer
      'on': '[fact_order_header::Customer_Key] = [dim_customer::Customer_Key]'
      type: LEFT_OUTER
      cardinality: MANY_TO_ONE
    - with: dim_store
      'on': '[fact_order_header::Store_Key] = [dim_store::Store_Key]'
      type: LEFT_OUTER
      cardinality: MANY_TO_ONE
  - name: dim_customer
    fqn: f1b88736-a6c2-45b7-8687-9bffe5d91836
  - name: dim_store
    fqn: fa181cf4-8920-4dc0-b797-6733ab0ca6b0
  - name: dim_product
    fqn: 0bb22627-d05e-4be3-9a98-78c16c7410b6
  description: 'Customer lifetime value and behavioral analytics with RFM scoring
    components, cross-sell penetration, return propensity, spend velocity, and loyalty-weighted
    profitability. Source: fact_order_detail joined through fact_order_header to dim_customer,
    dim_store, and dim_product.'
  formulas:
  - id: formula_Customer_Region
    name: Customer Region
    expr: '[dim_customer::Customer_Region]'
    description: Geographic region of the customer
  - id: formula_Customer_Tenure_Band
    name: Customer Tenure Band
    expr: if (diff_days([dim_customer::Customer_Since], today()) < 365) then 'New
      (<1yr)' else if (diff_days([dim_customer::Customer_Since], today()) < 730) then
      'Developing (1-2yr)' else if (diff_days([dim_customer::Customer_Since], today())
      < 1825) then 'Established (2-5yr)' else 'Veteran (5yr+)'
    description: Customer tenure cohort based on registration date
  - id: formula_Household_Composition
    name: Household Composition
    expr: if ([dim_customer::Number_Of_Children] = 0 AND [dim_customer::Marital_Status]
      = 'Single') then 'Single No Kids' else if ([dim_customer::Number_Of_Children]
      = 0 AND [dim_customer::Marital_Status] != 'Single') then 'Couple No Kids' else
      if (([dim_customer::Number_Of_Children] >= 1 AND [dim_customer::Number_Of_Children]
      <= 2)) then 'Small Family (1-2 kids)' else if ([dim_customer::Number_Of_Children]
      >= 3) then 'Large Family (3+ kids)' else 'Unknown'
    description: Household demographic composition
  - id: formula_Income_Bracket
    name: Income Bracket
    expr: if ([dim_customer::Annual_Income] < 30000) then 'Low (<)' else if (([dim_customer::Annual_Income]
      >= 30000 AND [dim_customer::Annual_Income] <= 59999)) then 'Lower-Mid (-)' else
      if (([dim_customer::Annual_Income] >= 60000 AND [dim_customer::Annual_Income]
      <= 99999)) then 'Upper-Mid (-)' else if (([dim_customer::Annual_Income] >= 100000
      AND [dim_customer::Annual_Income] <= 149999)) then 'High (-)' else 'Ultra-High
      (+)'
    description: Customer income bracket classification
  - id: formula_Loyalty_Tier
    name: Loyalty Tier
    expr: '[dim_customer::Store_Membership_Card]'
    description: Loyalty program tier (Bronze, Silver, Gold, None)
  - id: formula_Occupation
    name: Occupation
    expr: '[dim_customer::Occupation]'
    description: Customer occupation category
  - id: formula_Store_Region
    name: Store Region
    expr: '[dim_store::Store_Region]'
    description: Region of the transacting store
  - id: formula_Avg_Order_Value
    name: Avg Order Value
    expr: safe_divide(sum([fact_order_detail::Sales_Dollar_Amount]), unique count([fact_order_detail::POS_Transaction_Number]))
    description: Average revenue per unique transaction
  - id: formula_Basket_Complexity_Index
    name: Basket Complexity Index
    expr: safe_divide((unique count([fact_order_detail::Product_Key]) * log2(count(1)
      + 1)), unique count([fact_order_detail::POS_Transaction_Number]))
    description: Entropy-inspired basket complexity — unique products * log2(items)
      per transaction
  - id: formula_Cross_Category_Penetration
    name: Cross-Category Penetration
    expr: safe_divide(unique count([dim_product::Category]) * 1.0, unique count([fact_order_header::Customer_Key]))
    description: Average number of distinct product categories purchased per customer
      — measures cross-sell depth
  - id: formula_Frequency_Score
    name: Frequency Score
    expr: safe_divide(unique count([fact_order_detail::POS_Transaction_Number]) *
      1.0, unique count([fact_order_header::Customer_Key]))
    description: Average number of transactions per customer — RFM frequency component
  - id: formula_Gross_Margin_Spread
    name: Gross Margin Spread
    expr: (max(safe_divide([fact_order_detail::Gross_Profit_Dollar_Amount], [fact_order_detail::Sales_Dollar_Amount]))
      - min(safe_divide([fact_order_detail::Gross_Profit_Dollar_Amount], [fact_order_detail::Sales_Dollar_Amount])))
      * 100
    description: Range between highest and lowest margin items — measures margin consistency
  - id: formula_Loyalty_Weighted_Revenue
    name: Loyalty Weighted Revenue
    expr: sum([fact_order_detail::Sales_Dollar_Amount] * if ([dim_customer::Store_Membership_Card]
      = 'Gold') then 1.5 else if ([dim_customer::Store_Membership_Card] = 'Silver')
      then 1.25 else if ([dim_customer::Store_Membership_Card] = 'Bronze') then 1.1
      else 1.0)
    description: Revenue weighted by loyalty tier multiplier — Gold=1.5x, Silver=1.25x,
      Bronze=1.1x, None=1.0x
  - id: formula_Monetary_Score
    name: Monetary Score
    expr: safe_divide(sum([fact_order_detail::Sales_Dollar_Amount]), unique count([fact_order_header::Customer_Key]))
    description: Average lifetime monetary value per customer — RFM monetary component
  - id: formula_Multi_Store_Shopper_Index
    name: Multi-Store Shopper Index
    expr: safe_divide(unique count([fact_order_header::Store_Key]) * 1.0, unique count([fact_order_header::Customer_Key]))
    description: Average number of distinct stores visited per customer
  - id: formula_Net_Revenue_After_Returns
    name: Net Revenue After Returns
    expr: sum_if([fact_order_header::Transaction_Type] = 'Purchase', [fact_order_detail::Sales_Dollar_Amount])
      + sum_if([fact_order_header::Transaction_Type] = 'Return', [fact_order_detail::Sales_Dollar_Amount])
    description: Revenue from purchases minus return deductions
  - id: formula_Premium_Product_Affinity_Pct
    name: Premium Product Affinity Pct
    expr: safe_divide(sum_if(safe_divide([fact_order_detail::Sales_Dollar_Amount],
      [fact_order_detail::Sales_Quantity]) > 10, 1) * 100.0, count(1))
    description: Percentage of line items with unit price above  — indicates premium
      product preference
  - id: formula_Profit_Per_Customer
    name: Profit Per Customer
    expr: safe_divide(sum([fact_order_detail::Gross_Profit_Dollar_Amount]), unique
      count([fact_order_header::Customer_Key]))
    description: Average gross profit contribution per unique customer
  - id: formula_Return_Rate_Pct
    name: Return Rate Pct
    expr: safe_divide(unique count(if ([fact_order_header::Transaction_Type] = 'Return')
      then [fact_order_detail::POS_Transaction_Number] else null) * 100.0, unique
      count([fact_order_detail::POS_Transaction_Number]))
    description: Percentage of transactions that are returns
  - id: formula_Spend_Velocity
    name: Spend Velocity
    expr: safe_divide(sum([fact_order_detail::Sales_Dollar_Amount]), unique count(start_of_month([fact_order_header::Timestamp])))
    description: Average monthly spend rate (total spend / distinct active months)
  columns:
  - name: Customer Region
    description: Geographic region of the customer
    formula_id: formula_Customer_Region
    properties:
      column_type: ATTRIBUTE
  - name: Customer Tenure Band
    description: Customer tenure cohort based on registration date
    formula_id: formula_Customer_Tenure_Band
    properties:
      column_type: ATTRIBUTE
  - name: Household Composition
    description: Household demographic composition
    formula_id: formula_Household_Composition
    properties:
      column_type: ATTRIBUTE
  - name: Income Bracket
    description: Customer income bracket classification
    formula_id: formula_Income_Bracket
    properties:
      column_type: ATTRIBUTE
  - name: Loyalty Tier
    description: Loyalty program tier (Bronze, Silver, Gold, None)
    formula_id: formula_Loyalty_Tier
    properties:
      column_type: ATTRIBUTE
  - name: Occupation
    description: Customer occupation category
    formula_id: formula_Occupation
    properties:
      column_type: ATTRIBUTE
  - name: Payment Method
    description: Payment method used
    column_id: fact_order_header::Tender_Type
    properties:
      column_type: ATTRIBUTE
  - name: Product Category
    description: Product category purchased
    column_id: dim_product::Category
    properties:
      column_type: ATTRIBUTE
  - name: Store Region
    description: Region of the transacting store
    formula_id: formula_Store_Region
    properties:
      column_type: ATTRIBUTE
  - name: Transaction Type
    description: Purchase, Return, or Exchange
    column_id: fact_order_header::Transaction_Type
    properties:
      column_type: ATTRIBUTE
  - name: Avg Order Value
    description: Average revenue per unique transaction
    formula_id: formula_Avg_Order_Value
    properties:
      column_type: MEASURE
  - name: Basket Complexity Index
    description: Entropy-inspired basket complexity — unique products * log2(items)
      per transaction
    formula_id: formula_Basket_Complexity_Index
    properties:
      column_type: MEASURE
  - name: Cross-Category Penetration
    description: Average number of distinct product categories purchased per customer
      — measures cross-sell depth
    formula_id: formula_Cross_Category_Penetration
    properties:
      column_type: MEASURE
  - name: Frequency Score
    description: Average number of transactions per customer — RFM frequency component
    formula_id: formula_Frequency_Score
    properties:
      column_type: MEASURE
  - name: Gross Margin Spread
    description: Range between highest and lowest margin items — measures margin consistency
    formula_id: formula_Gross_Margin_Spread
    properties:
      column_type: MEASURE
  - name: Loyalty Weighted Revenue
    description: Revenue weighted by loyalty tier multiplier — Gold=1.5x, Silver=1.25x,
      Bronze=1.1x, None=1.0x
    formula_id: formula_Loyalty_Weighted_Revenue
    properties:
      column_type: MEASURE
  - name: Monetary Score
    description: Average lifetime monetary value per customer — RFM monetary component
    formula_id: formula_Monetary_Score
    properties:
      column_type: MEASURE
  - name: Multi-Store Shopper Index
    description: Average number of distinct stores visited per customer
    formula_id: formula_Multi_Store_Shopper_Index
    properties:
      column_type: MEASURE
  - name: Net Revenue After Returns
    description: Revenue from purchases minus return deductions
    formula_id: formula_Net_Revenue_After_Returns
    properties:
      column_type: MEASURE
  - name: Premium Product Affinity Pct
    description: Percentage of line items with unit price above  — indicates premium
      product preference
    formula_id: formula_Premium_Product_Affinity_Pct
    properties:
      column_type: MEASURE
  - name: Profit Per Customer
    description: Average gross profit contribution per unique customer
    formula_id: formula_Profit_Per_Customer
    properties:
      column_type: MEASURE
  - name: Return Rate Pct
    description: Percentage of transactions that are returns
    formula_id: formula_Return_Rate_Pct
    properties:
      column_type: MEASURE
  - name: Spend Velocity
    description: Average monthly spend rate (total spend / distinct active months)
    formula_id: formula_Spend_Velocity
    properties:
      column_type: MEASURE
  - name: Total Customer Spend
    description: Total lifetime spend across all transactions
    column_id: fact_order_detail::Sales_Dollar_Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
  properties:
    join_progressive: true
    is_bypass_rls: false
