worksheet:
  name: testing1_sales_overview__model
  tables:
  - name: testing1_sales_overview
    fqn: 20bc4aab-91f8-420c-80df-28bdb55d19fc
  joins: []
  columns:
  - name: Category
    column_type: ATTRIBUTE
  - name: Store_Region
    column_type: ATTRIBUTE
  - name: Store_State
    column_type: ATTRIBUTE
  - name: Transaction_Date
    column_type: ATTRIBUTE
  - name: Transaction_Type
    column_type: ATTRIBUTE
  - name: cost_amount
    formula: sum(Cost_Dollar_Amount)
    column_type: MEASURE
  - name: gross_profit_amount
    formula: sum(Gross_Profit_Dollar_Amount)
    column_type: MEASURE
  - name: sales_amount
    formula: sum(Sales_Dollar_Amount)
    column_type: MEASURE
  - name: sales_quantity
    formula: sum(Sales_Quantity)
    column_type: MEASURE
  - name: transaction_count
    formula: unique_count(POS_Transaction_Number)
    column_type: MEASURE
