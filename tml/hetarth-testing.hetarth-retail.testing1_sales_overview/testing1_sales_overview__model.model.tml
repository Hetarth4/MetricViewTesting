model:
  name: testing1_sales_overview
  model_tables:
  - name: testing1_sales_overview_model
    fqn: 9399afd8-137a-4625-aab7-2588f56f46dd
  formulas:
  - id: formula_transaction_count
    name: transaction_count
    expr: unique count([testing1_sales_overview_model::POS_Transaction_Number])
  columns:
  - name: category
    column_id: testing1_sales_overview_model::Category
    properties:
      column_type: ATTRIBUTE
  - name: store_region
    column_id: testing1_sales_overview_model::Store_Region
    properties:
      column_type: ATTRIBUTE
  - name: store_state
    column_id: testing1_sales_overview_model::Store_State
    properties:
      column_type: ATTRIBUTE
  - name: transaction_date
    column_id: testing1_sales_overview_model::Transaction_Date
    properties:
      column_type: ATTRIBUTE
  - name: transaction_type
    column_id: testing1_sales_overview_model::Transaction_Type
    properties:
      column_type: ATTRIBUTE
  - name: cost_amount
    column_id: testing1_sales_overview_model::Cost_Dollar_Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: gross_profit_amount
    column_id: testing1_sales_overview_model::Gross_Profit_Dollar_Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: sales_amount
    column_id: testing1_sales_overview_model::Sales_Dollar_Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: sales_quantity
    column_id: testing1_sales_overview_model::Sales_Quantity
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: transaction_count
    formula_id: formula_transaction_count
    properties:
      column_type: MEASURE
  properties:
    join_progressive: true
    is_bypass_rls: false
