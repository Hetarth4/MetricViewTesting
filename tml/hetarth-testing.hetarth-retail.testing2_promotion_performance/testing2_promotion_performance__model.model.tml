worksheet:
  name: testing2_promotion_performance
  tables:
  - name: retail_sales_data_model
    fqn: e9fc1fea-cdc6-4072-b32f-381aed60f552
  joins: []
  columns:
  - name: Category
    column_type: ATTRIBUTE
  - name: Promotion_Brand
    column_type: ATTRIBUTE
  - name: Promotion_Key
    column_type: ATTRIBUTE
  - name: Promotion_Region
    column_type: ATTRIBUTE
  - name: Transaction_Date
    column_type: ATTRIBUTE
  - name: avg_discount
    formula: average(Discount)
    column_type: MEASURE
  - name: gross_profit_amount
    formula: sum(Gross_Profit_Dollar_Amount)
    column_type: MEASURE
  - name: sales_amount
    formula: sum(Sales_Dollar_Amount)
    column_type: MEASURE
  - name: sales_quantity
    formula: sum(Sales_Quantity)
    column_type: MEASURE
  - name: transaction_count
    formula: unique_count(POS_Transaction_Number)
    column_type: MEASURE
