model:
  name: testing2_promotion_performance
  model_tables:
  - name: testing2_promotion_performance_model
    fqn: 9399afd8-137a-4625-aab7-2588f56f46dd
  formulas:
  - id: formula_transaction_count
    name: transaction_count
    expr: unique count([testing2_promotion_performance_model::POS_Transaction_Number])
  columns:
  - name: category
    column_id: testing2_promotion_performance_model::Category
    properties:
      column_type: ATTRIBUTE
  - name: promotion_brand
    column_id: testing2_promotion_performance_model::Promotion_Brand
    properties:
      column_type: ATTRIBUTE
  - name: promotion_key
    column_id: testing2_promotion_performance_model::Promotion_Key
    properties:
      column_type: ATTRIBUTE
  - name: promotion_region
    column_id: testing2_promotion_performance_model::Promotion_Region
    properties:
      column_type: ATTRIBUTE
  - name: transaction_date
    column_id: testing2_promotion_performance_model::Transaction_Date
    properties:
      column_type: ATTRIBUTE
  - name: avg_discount
    column_id: testing2_promotion_performance_model::Discount
    properties:
      column_type: MEASURE
      aggregation: AVERAGE
  - name: gross_profit_amount
    column_id: testing2_promotion_performance_model::Gross_Profit_Dollar_Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: sales_amount
    column_id: testing2_promotion_performance_model::Sales_Dollar_Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: sales_quantity
    column_id: testing2_promotion_performance_model::Sales_Quantity
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: transaction_count
    formula_id: formula_transaction_count
    properties:
      column_type: MEASURE
  properties:
    join_progressive: true
    is_bypass_rls: false
