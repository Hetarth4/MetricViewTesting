guid: c1dca304-a1d5-5c03-ad5a-8fbd69e5e437
model:
  name: promotion_effectiveness_metrics
  model_tables:
  - name: fact_order_detail
    fqn: d19573df-e106-4b11-904a-fe0078da9c01
    joins:
    - with: dim_promotion
      'on': '[fact_order_detail::Promotion_Key] = [dim_promotion::Promotion_Key]'
      type: LEFT_OUTER
      cardinality: MANY_TO_ONE
    - with: dim_product
      'on': '[fact_order_detail::Product_Key] = [dim_product::Product_Key]'
      type: LEFT_OUTER
      cardinality: MANY_TO_ONE
    - with: dim_diet_type
      'on': '[fact_order_detail::Diet_Key] = [dim_diet_type::Diet_Key]'
      type: LEFT_OUTER
      cardinality: MANY_TO_ONE
  - name: dim_promotion
    fqn: 713023c0-b8c7-4dad-8b03-85b28d64bb10
  - name: dim_product
    fqn: 0bb22627-d05e-4be3-9a98-78c16c7410b6
  - name: dim_diet_type
    fqn: 914e88a4-7e5f-41fb-884f-c45986ef993d
  description: 'Promotion effectiveness and discount impact KPIs. Excludes non-promoted
    items (PROMO000). Measures include promoted items sold, promoted revenue, gross
    profit, margin %, line count, and avg discount applied. Dimensions cover promo
    brand/department/product/region, discount tier, product category/brand, and diet
    type. Source: fact_order_detail joined to dim_promotion, dim_product, and dim_diet_type.'
  formulas:
  - id: formula_Discount_Tier
    name: Discount Tier
    expr: if ([dim_promotion::Discount] <= 0.1) then '10% or less' else if ([dim_promotion::Discount]
      <= 0.2) then '11-20%' else if ([dim_promotion::Discount] <= 0.3) then '21-30%'
      else 'Over 30%'
    description: Promotion discount bracket
  - id: formula_Avg_Discount_Applied
    name: Avg Discount Applied
    expr: average([dim_promotion::Discount]) * 100
    description: Average promotion discount percentage
  - id: formula_Promoted_Margin_Pct
    name: Promoted Margin Pct
    expr: sum([fact_order_detail::Gross_Profit_Dollar_Amount]) / sum([fact_order_detail::Sales_Dollar_Amount])
      * 100
    description: Margin percentage on promoted items
  - id: formula_Promotion_Line_Count
    name: Promotion Line Count
    expr: count(1)
    description: Number of line items with active promotions
  columns:
  - name: Diet Type
    description: Dietary classification of the product
    column_id: dim_diet_type::Diet_Type
    properties:
      column_type: ATTRIBUTE
  - name: Discount Tier
    description: Promotion discount bracket
    formula_id: formula_Discount_Tier
    properties:
      column_type: ATTRIBUTE
  - name: Product Brand
    description: Actual product brand
    column_id: dim_product::Brand
    properties:
      column_type: ATTRIBUTE
  - name: Product Category
    description: Product category
    column_id: dim_product::Category
    properties:
      column_type: ATTRIBUTE
  - name: Promo Brand
    description: Brand featured in the promotion
    column_id: dim_promotion::Brand
    properties:
      column_type: ATTRIBUTE
  - name: Promo Department
    description: Department of the promoted product
    column_id: dim_promotion::Department
    properties:
      column_type: ATTRIBUTE
  - name: Promo Product
    description: Promoted product type
    column_id: dim_promotion::Product
    properties:
      column_type: ATTRIBUTE
  - name: Promo Region
    description: Region where the promotion is active
    column_id: dim_promotion::Region
    properties:
      column_type: ATTRIBUTE
  - name: Avg Discount Applied
    description: Average promotion discount percentage
    formula_id: formula_Avg_Discount_Applied
    properties:
      column_type: MEASURE
  - name: Promoted Gross Profit
    description: Gross profit from promoted items
    column_id: fact_order_detail::Gross_Profit_Dollar_Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: Promoted Items Sold
    description: Total quantity of items sold on promotion
    column_id: fact_order_detail::Sales_Quantity
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: Promoted Margin Pct
    description: Margin percentage on promoted items
    formula_id: formula_Promoted_Margin_Pct
    properties:
      column_type: MEASURE
  - name: Promoted Revenue
    description: Total revenue from promoted items
    column_id: fact_order_detail::Sales_Dollar_Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: Promotion Line Count
    description: Number of line items with active promotions
    formula_id: formula_Promotion_Line_Count
    properties:
      column_type: MEASURE
  properties:
    join_progressive: true
    is_bypass_rls: false
