model:
  name: sales_performance_metrics
  model_tables:
  - name: sales_performance_metrics_model
    fqn: 3b84ea2f-5cf7-47dd-8436-802e0f4bd13d
    joins:
    - with: sales_performance_metrics_model__header
      'on': '[sales_performance_metrics_model::source.POS_Transaction_Number = header.POS_Transaction_Number]'
      type: LEFT_OUTER
      cardinality: MANY_TO_ONE
    - with: sales_performance_metrics_model__product
      'on': '[sales_performance_metrics_model::source.Product_Key = product.Product_Key]'
      type: LEFT_OUTER
      cardinality: MANY_TO_ONE
  - name: sales_performance_metrics_model__header
    fqn: 53778eeb-0480-4540-9a94-74383d8f3608
  - name: sales_performance_metrics_model__product
    fqn: 3e665e33-7ce5-4990-92c3-0a05a4164333
  formulas:
  - id: formula_Order_Month
    name: Order Month
    expr: start_of_month([sales_performance_metrics_model::header].Timestamp)
    description: Month of the transaction
  - id: formula_Avg_Basket_Value
    name: Avg Basket Value
    expr: sum([sales_performance_metrics_model::source].[sales_performance_metrics_model::Sales_Dollar_Amount])
      / [sales_performance_metrics_model::NULLIF](COUNT(DISTINCT [sales_performance_metrics_model::source].[sales_performance_metrics_model::POS_Transaction_Number]),
      0)
    description: Average dollar value per transaction
  - id: formula_Gross_Profit
    name: Gross Profit
    expr: sum([sales_performance_metrics_model::source].[sales_performance_metrics_model::Gross_Profit_Dollar_Amount])
    description: Total gross profit (Sales - Cost)
  - id: formula_Items_Sold
    name: Items Sold
    expr: sum([sales_performance_metrics_model::source].[sales_performance_metrics_model::Sales_Quantity])
    description: Total quantity of items sold
  - id: formula_Order_Count
    name: Order Count
    expr: unique count([sales_performance_metrics_model::source].[sales_performance_metrics_model::POS_Transaction_Number])
    description: Number of unique transactions
  - id: formula_Total_Cost
    name: Total Cost
    expr: sum([sales_performance_metrics_model::source].[sales_performance_metrics_model::Cost_Dollar_Amount])
    description: Total cost of goods sold
  - id: formula_Total_Sales
    name: Total Sales
    expr: sum([sales_performance_metrics_model::source].[sales_performance_metrics_model::Sales_Dollar_Amount])
    description: Total sales revenue in dollars
  columns:
  - name: Order Month
    description: Month of the transaction
    formula_id: formula_Order_Month
    properties:
      column_type: ATTRIBUTE
  - name: Product Brand
    description: Product brand name
    column_id: sales_performance_metrics_model__product::Brand
    properties:
      column_type: ATTRIBUTE
  - name: Product Category
    description: Product category (Grocery, Personal Care, etc.)
    column_id: sales_performance_metrics_model__product::Category
    properties:
      column_type: ATTRIBUTE
  - name: Product Type
    description: Product type within category
    column_id: sales_performance_metrics_model__product::Product
    properties:
      column_type: ATTRIBUTE
  - name: Tender Type
    description: Payment method used
    column_id: sales_performance_metrics_model__header::Tender_Type
    properties:
      column_type: ATTRIBUTE
  - name: Transaction Type
    description: Purchase, Return, or Exchange
    column_id: sales_performance_metrics_model__header::Transaction_Type
    properties:
      column_type: ATTRIBUTE
  - name: Avg Basket Value
    description: Average dollar value per transaction
    formula_id: formula_Avg_Basket_Value
    properties:
      column_type: MEASURE
  - name: Gross Profit
    description: Total gross profit (Sales - Cost)
    formula_id: formula_Gross_Profit
    properties:
      column_type: MEASURE
  - name: Items Sold
    description: Total quantity of items sold
    formula_id: formula_Items_Sold
    properties:
      column_type: MEASURE
  - name: Order Count
    description: Number of unique transactions
    formula_id: formula_Order_Count
    properties:
      column_type: MEASURE
  - name: Total Cost
    description: Total cost of goods sold
    formula_id: formula_Total_Cost
    properties:
      column_type: MEASURE
  - name: Total Sales
    description: Total sales revenue in dollars
    formula_id: formula_Total_Sales
    properties:
      column_type: MEASURE
  properties:
    join_progressive: true
    is_bypass_rls: false
