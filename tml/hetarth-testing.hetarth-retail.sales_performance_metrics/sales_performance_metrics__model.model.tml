guid: e2747b5b-698f-52d8-bd2e-0a9a8792f822
model:
  name: sales_performance_metrics
  model_tables:
  - name: fact_order_detail
    fqn: d19573df-e106-4b11-904a-fe0078da9c01
    joins:
    - with: fact_order_header
      'on': '[fact_order_detail::POS_Transaction_Number] = [fact_order_header::POS_Transaction_Number]'
      type: LEFT_OUTER
      cardinality: MANY_TO_ONE
    - with: dim_product
      'on': '[fact_order_detail::Product_Key] = [dim_product::Product_Key]'
      type: LEFT_OUTER
      cardinality: MANY_TO_ONE
  - name: fact_order_header
    fqn: a3d34975-6a7e-4168-ac9a-8099d757e0b2
  - name: dim_product
    fqn: 0bb22627-d05e-4be3-9a98-78c16c7410b6
  description: 'Sales performance KPIs across products and time periods. Measures
    include total sales, gross profit, margin %, order count, items sold, and average
    basket value. Dimensions cover order date/month/year, product category/brand/type,
    transaction type, and tender type. Source: fact_order_detail joined to fact_order_header
    and dim_product.'
  formulas:
  - id: formula_Order_Date
    name: Order Date
    expr: date([fact_order_header::Timestamp])
    description: Date of the transaction
  - id: formula_Order_Month
    name: Order Month
    expr: start_of_month([fact_order_header::Timestamp])
    description: Month of the transaction
  - id: formula_Order_Year
    name: Order Year
    expr: year([fact_order_header::Timestamp])
    description: Year of the transaction
  - id: formula_Avg_Basket_Value
    name: Avg Basket Value
    expr: sum([fact_order_detail::Sales_Dollar_Amount]) / unique count([fact_order_detail::POS_Transaction_Number])
    description: Average dollar value per transaction
  - id: formula_Gross_Margin_Pct
    name: Gross Margin Pct
    expr: sum([fact_order_detail::Gross_Profit_Dollar_Amount]) / sum([fact_order_detail::Sales_Dollar_Amount])
      * 100
    description: Gross margin percentage
  - id: formula_Order_Count
    name: Order Count
    expr: unique count([fact_order_detail::POS_Transaction_Number])
    description: Number of unique transactions
  columns:
  - name: Order Date
    description: Date of the transaction
    formula_id: formula_Order_Date
    properties:
      column_type: ATTRIBUTE
  - name: Order Month
    description: Month of the transaction
    formula_id: formula_Order_Month
    properties:
      column_type: ATTRIBUTE
  - name: Order Year
    description: Year of the transaction
    formula_id: formula_Order_Year
    properties:
      column_type: ATTRIBUTE
  - name: Product Brand
    description: Product brand name
    column_id: dim_product::Brand
    properties:
      column_type: ATTRIBUTE
  - name: Product Category
    description: Product category (Grocery, Personal Care, etc.)
    column_id: dim_product::Category
    properties:
      column_type: ATTRIBUTE
  - name: Product Type
    description: Product type within category
    column_id: dim_product::Product
    properties:
      column_type: ATTRIBUTE
  - name: Tender Type
    description: Payment method used
    column_id: fact_order_header::Tender_Type
    properties:
      column_type: ATTRIBUTE
  - name: Transaction Type
    description: Purchase, Return, or Exchange
    column_id: fact_order_header::Transaction_Type
    properties:
      column_type: ATTRIBUTE
  - name: Avg Basket Value
    description: Average dollar value per transaction
    formula_id: formula_Avg_Basket_Value
    properties:
      column_type: MEASURE
  - name: Gross Margin Pct
    description: Gross margin percentage
    formula_id: formula_Gross_Margin_Pct
    properties:
      column_type: MEASURE
  - name: Gross Profit
    description: Total gross profit (Sales - Cost)
    column_id: fact_order_detail::Gross_Profit_Dollar_Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: Items Sold
    description: Total quantity of items sold
    column_id: fact_order_detail::Sales_Quantity
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: Order Count
    description: Number of unique transactions
    formula_id: formula_Order_Count
    properties:
      column_type: MEASURE
  - name: Total Cost
    description: Total cost of goods sold
    column_id: fact_order_detail::Cost_Dollar_Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: Total Sales
    description: Total sales revenue in dollars
    column_id: fact_order_detail::Sales_Dollar_Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
  properties:
    join_progressive: true
    is_bypass_rls: false
